# Supabase 프로젝트 설정
# https://supabase.com/dashboard에서 프로젝트 생성 후 아래 값을 입력하세요

# Supabase 프로젝트 URL
# 예시: https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase 공개 가능 키 (클라이언트 사이드에서 사용)
# Dashboard > Settings > API Keys에서 "anon" 또는 "public" 키 복사
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# 선택사항: Google OAuth 설정
# Google Cloud Console에서 OAuth 클라이언트 ID 설정 후 사용
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
